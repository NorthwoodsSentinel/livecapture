{
  "name": "livecapture",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "d1:create": "wrangler d1 create livecapture-db",
    "d1:migrate": "wrangler d1 migrations apply livecapture-db --remote",
    "kv:create": "wrangler kv namespace create SESSION_STATE",
    "r2:create": "wrangler r2 bucket create livecapture-raw-audio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage && bun scripts/verify-gate-scope.ts",
    "local:gate": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
